{
  "working_directory": "C:/projects/ai-dashboard",
  "runtime_directory": "C:/private/ai-dashboard-dev",
  "environment": {
    "DASHBOARD_DB_PATH": "C:/private/ai-dashboard-dev/dashboard.sqlite3",
    "DASHBOARD_WEB_DIR": "C:/projects/ai-dashboard/web",
    "DASHBOARD_VIEW_USERNAME": "REPLACE_WITH_DEV_USERNAME",
    "DASHBOARD_VIEW_PASSWORD": "REPLACE_WITH_DEV_PASSWORD"
  },
  "components": [
    {
      "name": "app",
      "command": [
        "C:/projects/ai-dashboard/.venv/Scripts/python.exe",
        "-m",
        "dashboard.server",
        "--host",
        "127.0.0.1",
        "--port",
        "8810"
      ]
    }
  ]
}
