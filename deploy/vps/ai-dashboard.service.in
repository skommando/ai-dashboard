[Unit]
Description=AI Dashboard application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-dashboard
Group=ai-dashboard
WorkingDirectory=@ROOT@/current
EnvironmentFile=@ROOT@/shared/dashboard.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@ROOT@/current/.venv/bin/python -m dashboard.server --host 127.0.0.1 --port 8810
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=@ROOT@/shared/data

[Install]
WantedBy=multi-user.target
